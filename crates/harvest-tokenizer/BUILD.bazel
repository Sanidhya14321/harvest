load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])

rust_library(
    name = "harvest-tokenizer",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "harvest_tokenizer",
    compile_data = glob(["data/*.bin.zst", "fixtures/*.json", "src/utok/claude/testdata/*.json"]),
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "tokenizer_test",
    crate = ":harvest-tokenizer",
    compile_data = glob(["fixtures/*.json", "src/utok/claude/testdata/*.json"]),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True),
)
